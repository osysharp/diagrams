// THE LAYOUT, held to what must be true of a picture — never to pixels. Each test draws one fixture graph
// (`model/pictures.osy`) and reads what the canvas counted about its own layout: no two nodes overlap, no edge lies on
// another or passes through a node, every edge that is not a return leads to a later rank, the ends share the last
// rank, the main path is one straight line, and the edges cross no more often than the number recorded here.
//
// Without a browser nothing can be measured, so the canvas lays a picture out at a nominal node size: the ranks, the
// order and the routes are the real algorithm's. `osy test --pixels` runs the same tests in a real browser, at the
// sizes the nodes really have, wide and on a phone, light and dark, and photographs each (`Ui.Shot`).
using Osysharp.Diagrams;

void Sound() {
  Assert.Probe("FlowCanvas", "nodeOverlaps", 0);
  Assert.Probe("FlowCanvas", "overlaps", 0);
  Assert.Probe("FlowCanvas", "throughNodes", 0);
  Assert.Probe("FlowCanvas", "labelsOnNodes", 0);
  Assert.Probe("FlowCanvas", "backward", 0);
  Assert.Probe("FlowCanvas", "endsNotLast", 0);
  Assert.Probe("FlowCanvas", "mainStraight", true);
}

void Photograph(string name) {
  Ui.Shot(name + "-wide-light");
  Ui.Theme("dark");
  Ui.Shot(name + "-wide-dark");
  Ui.Theme("light");
  Ui.Viewport(390, 844);
  Ui.Visit("/pictures/" + name);
  Sound();
  Assert.NoOverflow();
  Ui.Shot(name + "-phone-light");
  Ui.Theme("dark");
  Ui.Shot(name + "-phone-dark");
  Ui.Theme("light");
}

/// The supplier qualification: five ranks, the way to "Approved" on one row, all four ends in the last rank, and —
/// with "Withdrawn" reachable from every step — not one crossing.
[Test]
void the_supplier_qualification_is_five_ranks_with_no_crossing() {
  Ui.Visit("/pictures/supplier");
  Assert.Probe("FlowCanvas", "nodes", 8);
  Assert.Probe("FlowCanvas", "edges", 11);
  Assert.Probe("FlowCanvas", "ranks", 5);
  Assert.Probe("FlowCanvas", "mainPath", "Screening > Assessing > ByHand > Deciding > Approved");
  Assert.Probe("FlowCanvas", "crossings", 0);
  Assert.Probe("FlowCanvas", "returns", 0);
  Sound();
  Photograph("supplier");
}

/// Five states in a line are five ranks on one straight row.
[Test]
void a_line_of_five_is_one_straight_row() {
  Ui.Visit("/pictures/linear");
  Assert.Probe("FlowCanvas", "ranks", 5);
  Assert.Probe("FlowCanvas", "mainPath", "A > B > C > D > E");
  Assert.Probe("FlowCanvas", "crossings", 0);
  Sound();
  Photograph("linear");
}

/// A diamond: two ways round, three ranks, no crossing.
[Test]
void a_diamond_is_three_ranks_and_does_not_cross() {
  Ui.Visit("/pictures/diamond");
  Assert.Probe("FlowCanvas", "ranks", 3);
  Assert.Probe("FlowCanvas", "crossings", 0);
  Sound();
  Photograph("diamond");
}

/// A retry is a cycle. The edge that closes it is a RETURN — drawn against the flow — and nothing else points back;
/// the loop on one node and every label have room of their own.
[Test]
void a_retry_is_drawn_as_one_return_and_a_loop() {
  Ui.Visit("/pictures/retry");
  Assert.Probe("FlowCanvas", "edges", 6);
  Assert.Probe("FlowCanvas", "returns", 1);
  Assert.Probe("FlowCanvas", "mainPath", "A > B > D");
  Assert.Probe("FlowCanvas", "crossings", 0);
  Sound();
  Photograph("retry");
}

/// Two starts share the first rank.
[Test]
void two_starts_share_the_first_rank() {
  Ui.Visit("/pictures/twostart");
  Assert.Probe("FlowCanvas", "ranks", 5);
  Assert.Probe("FlowCanvas", "crossings", 0);
  Sound();
  Photograph("twostart");
}

/// An edge from a node to itself is a loop beside the node, not a line through it.
[Test]
void a_self_loop_is_a_loop() {
  Ui.Visit("/pictures/selfloop");
  Assert.Probe("FlowCanvas", "edges", 3);
  Assert.Probe("FlowCanvas", "ranks", 3);
  Assert.Probe("FlowCanvas", "crossings", 0);
  Sound();
  Photograph("selfloop");
}

/// Twenty states and thirty-five transitions: still sound, four returns, and no more crossings than recorded.
[Test]
void twenty_states_and_thirty_five_transitions_stay_sound() {
  Ui.Visit("/pictures/big");
  Assert.Probe("FlowCanvas", "nodes", 20);
  Assert.Probe("FlowCanvas", "edges", 35);
  Assert.Probe("FlowCanvas", "returns", 4);
  Assert.Probe("FlowCanvas", "crossings", 11);
  Sound();
  Photograph("big");
}

/// The same graph is the same picture: laid out again, every position and every route comes out the same.
[Test]
void the_same_graph_is_the_same_picture() {
  Ui.Visit("/pictures/big");
  Assert.Probe("FlowCanvas", "nodes", 20);
  Assert.Probe("FlowCanvas", "stable", true);
  Ui.Visit("/pictures/retry");
  Assert.Probe("FlowCanvas", "stable", true);
}

/// One transition more does not rearrange the picture: the same ranks, the same main path, and the one crossing the
/// new edge needs.
[Test]
void one_more_transition_keeps_the_picture() {
  Ui.Visit("/pictures/supplier-more");
  Assert.Probe("FlowCanvas", "edges", 12);
  Assert.Probe("FlowCanvas", "ranks", 5);
  Assert.Probe("FlowCanvas", "mainPath", "Screening > Assessing > ByHand > Deciding > Approved");
  Assert.Probe("FlowCanvas", "crossings", 1);
  Sound();
}

/// Which way it flows: left to right in a wide box, and right to left where the page reads that way.
[Test]
void a_picture_flows_the_way_the_page_reads() {
  Ui.Visit("/pictures/retry");
  Assert.Probe("FlowCanvas", "direction", "right");
  Ui.Visit("/rtl/retry");
  Assert.Probe("FlowCanvas", "direction", "left");
  Sound();
  Ui.Shot("retry-rtl-wide-light");
}

/// The picture is also there in words, for someone who cannot see it: every node in the order it is drawn, what it
/// is, and where its edges lead — a return said as a way back.
[Test]
void the_picture_is_there_in_words() {
  Ui.Visit("/pictures/selfloop");
  Assert.Probe("FlowCanvas", "outline", "3 nodes and 3 edges, drawn left to right. 1. Idle (start): to Polling on Start. 2. Polling: to itself on Tick; to Stopped on Stop. 3. Stopped (end).");
  Assert.Visible("3 nodes and 3 edges, drawn left to right.");
}

/// A run on the picture: the edges it took are marked taken — and only those, not every edge between two places it
/// has been — and the picture says the same in words.
[Test]
void a_run_marks_the_edges_it_took_and_no_others() {
  Ui.Visit("/run/now");
  Assert.Probe("FlowCanvas", "edgesTaken", 3);
  Sound();
  Ui.Shot("run-wide-light");
  Ui.Theme("dark");
  Ui.Shot("run-wide-dark");
  Ui.Theme("light");
  Ui.Visit("/run/failed");
  Assert.Probe("FlowCanvas", "edgesTaken", 1);
  Ui.Shot("run-failed-wide-light");
  Ui.Theme("dark");
  Ui.Shot("run-failed-wide-dark");
  Ui.Theme("light");
}
