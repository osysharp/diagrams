// Osysharp.Diagrams as a package — a manifest that carries a CONTROL and its chunks.
//
// `flow.osy` declares `control FlowCanvas`; `flow.js` is its shim; `xyflow-system.js` (chunk XY — React Flow's
// framework-independent core, MIT) loads at mount and `layered-layout.js` (chunk Layout — the kit's own layered layout
// and edge router, built from `layout.ts`) only when a canvas lays itself out. The platform re-hashes each against
// `osyrin.lock` at load. `tests/` is the kit's own test project.
package Osysharp.Diagrams {
  version "0.6.0";
  minPlatform "0.15.0";
  contract    "1.1";
  summary     "a node/edge canvas: a laid-out picture of a process with a run's path on it, or an editor — pan, zoom, drag, connect; nodes rendered by the app's own Osy#.";

  model    "*.osy";
  controls "osyrin.lock";
  controls "flow.js";
  controls "xyflow-system.js";
  controls "layered-layout.js";
  tests    "tests";
}
